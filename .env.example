PROJECT_NAME=VAJRA Backend
VERSION=1.0.0
API_V1_STR=/api/v1
APP_ENV=production

# Database (PostgreSQL for production, SQLite for local dev)
# Production format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/vajra

# Supabase / JWT Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret-min-32-chars

# CORS (comma-separated or JSON list of allowed origins, * for all)
BACKEND_CORS_ORIGINS=["*"]

# LLM Configuration
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional Direct Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
